{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Popular Rules Source Snapshot v2",
  "type": "object",
  "required": ["schema", "snapshot_id", "content_digest", "service_id", "created_at", "domain_count", "domains", "assets", "evidence", "release_state"],
  "properties": {
    "schema": {"const": "source_snapshot_v2"},
    "snapshot_id": {"type": "string"},
    "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generator_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_identity_version": {"const": "2"},
    "service_id": {"type": "string"},
    "created_at": {"type": "string"},
    "domain_count": {"type": "integer", "minimum": 0},
    "domains": {"type": "array", "items": {"type": "string"}},
    "assets": {"type": "array", "items": {"$ref": "asset.schema.json"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "release_state": {"enum": ["BLOCKED", "REVIEW", "CANDIDATE", "PUBLISHED"]},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
