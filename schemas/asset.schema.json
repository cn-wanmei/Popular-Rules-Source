{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Popular Rules Source Asset",
  "type": "object",
  "required": ["asset_id", "service_id", "type", "value", "classification", "evidence_ids"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "service_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "type": {"enum": ["domain", "ip", "cidr"]},
    "value": {"type": "string", "minLength": 1},
    "classification": {"enum": ["service", "shared", "provider", "external_dependency", "infrastructure", "unknown"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
