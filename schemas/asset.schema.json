{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cn-wanmei/Popular-Rules-Source/schemas/asset.schema.json",
  "title": "Asset",
  "type": "object",
  "required": ["asset_id", "service_id", "type", "value"],
  "additionalProperties": true,
  "properties": {
    "asset_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "service_id": { "type": "string" },
    "type": { "type": "string", "enum": ["domain", "ip", "cidr"] },
    "value": { "type": "string" },
    "classification": {
      "type": "string",
      "enum": ["service", "shared", "external_dependency", "provider", "infrastructure", "unknown"]
    },
    "source_id": { "type": "string" },
    "source_method": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "snapshot": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["candidate", "verified", "materialized", "revoked", "rejected"]
    }
  }
}
