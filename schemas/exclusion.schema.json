{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Popular Rules Source Exclusion",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"type": ["integer", "string"]},
    "global": {
      "type": "object",
      "properties": {
        "blocked_suffixes": {"type": "array", "items": {"type": "string"}},
        "blocked_exact": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "include"],
        "properties": {
          "asset": {"type": "string"},
          "include": {"type": "boolean"},
          "reason": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "services": {"type": "object"}
  },
  "additionalProperties": true
}
