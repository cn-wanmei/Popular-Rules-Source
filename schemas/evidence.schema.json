{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cn-wanmei/Popular-Rules-Source/schemas/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": ["evidence_id", "service_id", "source_url", "source_method", "retrieved_at", "content_hash"],
  "additionalProperties": true,
  "properties": {
    "evidence_id": { "type": "string" },
    "service_id": { "type": "string" },
    "source_url": { "type": "string" },
    "source_method": { "type": "string" },
    "source_type": { "type": "string" },
    "authority": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "content_hash": { "type": "string" },
    "parser_version": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "strength": { "type": "string", "enum": ["S0", "S1", "S2", "S3"] },
    "status": { "type": "string", "enum": ["verified", "candidate", "rejected", "stale"] },
    "polarity": { "type": "string", "enum": ["positive", "negative"] },
    "notes": { "type": "string" }
  }
}
